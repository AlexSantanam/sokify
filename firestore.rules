rules_version = '2';

// UNIVERSO693 · Starter Restaurante QR — Reglas de seguridad de Firestore
// Proyecto compartido "Zoco": aloja a VARIOS restaurantes clientes dentro
// de la misma base de datos, separados por restaurantId. Pega este archivo
// completo en: Firebase Console -> Firestore Database -> Reglas.
//
// Modelo:
//   restaurantes/{restaurantId}                     -> estado del local (abierto, promo, ownerUids)
//   restaurantes/{restaurantId}/categorias/{catId}   -> categorías de la carta
//   restaurantes/{restaurantId}/platos/{platoId}     -> platos, precios y stock
//   restaurantes/{restaurantId}/pedidos/{pedidoId}   -> comandas entrantes
//   restaurantes/{restaurantId}/clientes/{telefono}  -> CRM (ficha por cliente)
//   restaurantes/{restaurantId}/descuentos/{codigo}  -> códigos de descuento
//
// NOTA: la escritura en restaurantes/* y sus subcolecciones solo exige estar
// autenticado (request.auth != null), NO todavía ser dueño verificado
// (ownerUids). Esto es así a propósito: el flujo de registro de un local
// nuevo escribe ownerUids por primera vez, así que una regla isOwner()
// estricta bloquearía el alta de cualquier restaurante nuevo. Si en el
// futuro se quiere exigir ownerUids, hay que separar primero el flujo de
// alta (ej. una Cloud Function) del resto de escrituras.

service cloud.firestore {
  match /databases/{database}/documents {

    match /restaurantes/{restaurantId} {
      allow read: if true;
      // Permite editar los datos del restaurante a usuarios autenticados
      allow write: if request.auth != null;

      match /categorias/{catId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /platos/{platoId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /pedidos/{pedidoId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null;
      }

      match /clientes/{telefono} {
        allow create, update: if true;
        allow read, delete: if request.auth != null;
      }

      match /descuentos/{codigo} {
        allow read, update: if true;
        allow create, delete: if request.auth != null;
      }
    }

    // Equipo Zokify autorizado a crear/editar/eliminar cupones de PLANES
    // (descuentos sobre la suscripción a Zokify, no sobre un restaurante).
    // Mantén esta lista sincronizada con ZOKIFY_ADMIN_EMAILS en admin-cupones.html.
    function isZokifyAdmin() {
      return request.auth != null && request.auth.token.email in [
        'contacto@zokify.app',
      ];
    }

    // Cupones de PLANES (suscripción a Zokify), colección a nivel raíz —
    // administrados solo por el equipo Zokify desde admin-cupones.html.
    match /cuponesPlanes/{codigo} {
      // Lectura pública: panel.html necesita poder validar un código al aplicarlo.
      allow get: if true;
      // Listar todos los cupones (tabla del admin) solo para el equipo Zokify.
      allow list: if isZokifyAdmin();
      // Cualquier cuenta autenticada puede incrementar el contador de usos
      // en +1 al aplicar el cupón, pero no puede tocar ningún otro campo
      // (evita que un restaurante se autoconceda descuentos o reactive cupones).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos'])
        && request.resource.data.usos == resource.data.usos + 1;
      allow create, delete: if isZokifyAdmin();
    }
  }
}
